{
  "mcpServers": {
    "ruflo": {
      "command": "node",
      "args": [
        "node_modules/ruflo/bin/ruflo.js",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_MAX_AGENTS": "3",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical"
      }
    }
  }
}
